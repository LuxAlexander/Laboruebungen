# Read by the VS Code Python extension (python.envFile in settings.json).
# MANAGE_PY_PATH switches test discovery and runs to Django's test runner (manage.py test),
# so the models can be imported. See https://code.visualstudio.com/docs/python/testing#_django-unit-tests
# The path is relative to the workspace root, which is the working directory of the test process.
MANAGE_PY_PATH=manage.py
DJANGO_SETTINGS_MODULE=swd_django_demo.settings
